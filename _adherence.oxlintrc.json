{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/js/**",
              "contenu.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Hanken Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Hanken Grotesk."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--ambre",
      "--encre",
      "--encre-2",
      "--encre-doux",
      "--filet",
      "--filet-fort",
      "--marge",
      "--papier",
      "--papier-alt",
      "--papier-blanc",
      "--sans",
      "--serif",
      "--vert"
    ],
    "tokenKinds": {
      "--papier": "color",
      "--papier-alt": "color",
      "--papier-blanc": "color",
      "--encre": "color",
      "--encre-2": "color",
      "--encre-doux": "color",
      "--ambre": "color",
      "--vert": "color",
      "--filet": "color",
      "--filet-fort": "color",
      "--serif": "font",
      "--sans": "font",
      "--marge": "spacing"
    },
    "fontFamilies": [
      "Hanken Grotesk",
      "Newsreader"
    ]
  }
}